{
    "name": "GateKeep",
    "description": "A secure password manager extension",
    "version": "1.0",
    "manifest_version": 3,
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "action": {
      "default_popup": "login_extension.html",
      "default_icon": "icons/icon48.png"
    },
    "permissions": [
      "storage",
      "activeTab"
    ],
    "options_page": "home_extension.html"
  }